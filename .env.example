# Each one is read from the environment first, then the vault, then the OS keyring;
# `push login` and `bun run deploy login` store them there.

# Sending: `push send`, and the client.
PUSH_URL=https://push.example.com
PUSH_API_KEY=

# `push device status | reset`, on the machine that deploys.
PUSH_ADMIN_KEY=

# Deploying: `bun run deploy`.
WORKER_CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# ECDSA P-256 private JWK, from `passkey-auth vault generate VAPID_PRIVATE_KEY --vapid`.
VAPID_PRIVATE_KEY=
# Pushover, for `push send --pushover`.
PUSH_APP_TOKEN=
PUSH_USER_KEY=

# Optional, for the local Worker and the tests.
# DEV_PORT=1350
# PUSH_SERVICE_ORIGIN=
# PUSHOVER_ORIGIN=
